APP_NAME=execution-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8083

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

# Sem banco relacional: estado em DynamoDB, cache/sessão em arquivo.
DB_CONNECTION=sqlite
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

AWS_DEFAULT_REGION=us-east-1
# LocalStack (docker-compose). Em EKS deixe vazio: SDK usa endpoint real + LabRole.
AWS_ENDPOINT_URL=http://localstack:4566

DYNAMODB_TABLE_PREFIX=local-execution

MESSAGING_DRIVER=sqs
MESSAGING_QUEUE_PREFIX=local

# Mesmo JWT_SECRET do os-service (valida o token de funcionário)
JWT_SECRET=

# New Relic (vazio = agente inerte)
NEWRELIC_LICENSE_KEY=
NEWRELIC_APPNAME=execution-service
